From 68af619c819dbc7f04e05e275fca7d1a57061874 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 2 Nov 2026 21:37:40 +0000
Subject: [PATCH] Show What's new only on the home screen

The corner button stays on the lobby with the game list and hides once a project is open.
---
 app/forge-extra.css | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/app/forge-extra.css b/app/forge-extra.css
index c946ae6..fcc31af 100644
--- a/app/forge-extra.css
+++ b/app/forge-extra.css
@@ -128,7 +128,7 @@ body.is-playing #studioLang{visibility:visible;pointer-events:auto;position:fixe
 .log-badge{font-style:normal;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:#ff9a4a}
 .btn.log-open.has-new{box-shadow:inset 0 0 0 1px rgba(255,122,26,.7)}
 .log-corner{display:none;position:fixed;z-index:54;right:max(16px, env(safe-area-inset-right, 0px));bottom:calc(16px + env(safe-area-inset-bottom, 0px));background:rgba(18,20,28,.92);border-color:rgba(255,255,255,.14);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 8px 28px rgba(0,0,0,.35)}
-body[data-screen="studio"]:not(.is-playing) .log-corner{display:inline-flex}
+body[data-screen="intro"] .log-corner{display:inline-flex}
 .st-assets.collapsed .assets{display:none}
 .st-assets .st-sec{cursor:pointer;user-select:none}
 .st-assets .st-sec .chev-col{margin-left:auto;width:16px;height:16px;opacity:.7;transition:transform .2s}
-- 
