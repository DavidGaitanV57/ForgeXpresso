# Copia este archivo como .env.local y rellena tus claves.
# Las claves solo se leen en el servidor; nunca llegan al navegador.

# --- Código (obligatorio) ---
ANTHROPIC_API_KEY=
# Modelo para escribir y reparar el código del juego.
ANTHROPIC_MODEL_CODE=claude-opus-5-5
# Modelo para el director de juego (documento de diseño) y el chat de cambios.
ANTHROPIC_MODEL_FAST=claude-sonnet-5-5

# --- Imágenes ---
# Proveedor por defecto: openai | minimax
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
MINIMAX_API_KEY=
# Internacional: https://api.minimax.io  ·  China: https://api.minimaxi.com
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_IMAGE_MODEL=image-01

# --- Audio ---
ELEVENLABS_API_KEY=
# Voz para la narración de la cinemática (opcional).
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Modelos 3D (opcional) ---
# Si está vacío, los juegos 3D usan geometría procedural con texturas generadas.
TRIPO_API_KEY=

# Carpeta donde se guardan los proyectos (por defecto ./data/projects)
FORGE_DATA_DIR=

# Contraseña del estudio y de la API al publicar (vacía = sin contraseña, para local)
FORGE_PASSWORD=
