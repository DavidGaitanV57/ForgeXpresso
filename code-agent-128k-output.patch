From 175ad7a46d6238bed341ccf1465af50d5777647c Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Mon, 2 Nov 2026 17:46:17 +0000
Subject: [PATCH] Give the code agent the full 128K output budget so game code
 is not cut off at 64K

---
 lib/agents/code.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/agents/code.ts b/lib/agents/code.ts
index 6a1bf8b..b6610bd 100644
--- a/lib/agents/code.ts
+++ b/lib/agents/code.ts
@@ -128,7 +128,7 @@ export async function codeAgent(input: CodeInput): Promise<string> {
       model: config.anthropic.codeModel(),
       system: SYSTEM(engine),
       messages,
-      maxTokens: 64000,
+      maxTokens: 128000,
       think: true,
     });
     input.onUsage?.(usage, attempt === 0 ? `code:${input.mode}` : `code:fix${attempt + 1}`);
