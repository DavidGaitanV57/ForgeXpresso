              "ease": "easeIn"
            },
            "fx": [
              "coin_sparkle_chain",
              "powerup_teaser_flash",
              "zoom_whip_blur"
            ]
          },
          {
            "lineIndex": 2,
            "durationSec": 4.4,
            "staging": "Camera drops behind Kiko into the gameplay framing. He dashes forward, does a jump over a low barrier, then a slide under a high one, then swerves into the next lane while collecting a coin arc. Parallax accelerates and the lane lines speed up. On the last beat he lands center-la",
            "camera": {
              "from": [
                0,
